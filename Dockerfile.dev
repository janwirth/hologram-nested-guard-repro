ARG ELIXIR_VERSION=1.20.4
ARG OTP_VERSION=28.1.1
ARG DEBIAN_VERSION=bookworm-20260918-slim
ARG NODE_VERSION=22

FROM node:${NODE_VERSION}-bookworm-slim AS node

FROM hexpm/elixir:${ELIXIR_VERSION}-erlang-${OTP_VERSION}-debian-${DEBIAN_VERSION}

RUN apt-get update -y && apt-get install -y build-essential git inotify-tools curl \
  && apt-get clean && rm -f /var/lib/apt/lists/*_*

# Hologram's compiler bundles with esbuild from its own node_modules.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm

WORKDIR /app
RUN mix local.hex --force && mix local.rebar --force

ENV MIX_ENV=dev
EXPOSE 4100

CMD ["sh", "-c", "mix deps.get && mix phx.server"]
